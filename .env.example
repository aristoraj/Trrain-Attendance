# ─────────────────────────────────────────────────────────────────────────────
# .env.example — copy this to .env for local development
# NEVER commit .env to git (it's in .gitignore)
# On Render, set these in the dashboard under Environment → Environment Variables
# ─────────────────────────────────────────────────────────────────────────────

# ── HOW TO GET ZOHO OAUTH CREDENTIALS ─────────────────────────────────────────
# 1. Go to https://api-console.zoho.com
# 2. Create a "Self Client" application
# 3. Scopes needed:
#      ZohoCreator.report.READ
#      ZohoCreator.form.CREATE
# 4. Generate code with those scopes (one-time)
# 5. Exchange code for refresh_token via Postman or curl
#    POST https://accounts.zoho.com/oauth/v2/token
#      grant_type=authorization_code
#      client_id=YOUR_CLIENT_ID
#      client_secret=YOUR_CLIENT_SECRET
#      redirect_uri=https://www.zoho.com (or your redirect)
#      code=THE_CODE_FROM_STEP_4
# ─────────────────────────────────────────────────────────────────────────────

# Zoho OAuth 2.0 Credentials
ZOHO_CLIENT_ID=your_client_id_here
ZOHO_CLIENT_SECRET=your_client_secret_here
ZOHO_REFRESH_TOKEN=your_refresh_token_here

# Zoho Creator App Config
# ZOHO_ACCOUNT_OWNER: your Zoho account username (shown in Creator URL)
# Example: if your app URL is creator.zoho.com/aristo/student_management → "aristo"
ZOHO_ACCOUNT_OWNER=your_zoho_username
ZOHO_APP_NAME=student_management
ZOHO_STUDENT_REPORT=All_Trainees
ZOHO_ATTENDANCE_FORM=Face_Attendance
ZOHO_ATTENDANCE_REPORT=All_Face_Attendances

# Data center: com | eu | in | com.au | jp
ZOHO_DATA_CENTER=com

# ── Field Names (link names from Zoho Creator, NOT display names) ──────────────
# To find link names: Creator → Form → Settings → "Link name" column
FIELD_STUDENT_NAME=Name
FIELD_STUDENT_PHOTO=Upload_Photo1
FIELD_STUDENT_NUMBER=Registration_No
FIELD_STUDENT_EMBEDDING=Face_Embedding
FIELD_STUDENT_CENTER=Centre_Name

FIELD_ATT_STUDENT=Trainee
FIELD_ATT_DATE=Date_field
FIELD_ATT_STATUS=Attendance

ZOHO_CENTRES_REPORT=All_Centres
FIELD_CENTRE_LOGIN_EMAIL=Email
FIELD_CENTRE_NAME=Centre_Name

# ── Batch Filtering ─────────────────────────────────────────────────────────────
# These filter trainees to only those in currently-active batches
ZOHO_BATCHES_REPORT=All_Batches
FIELD_BATCH_STATUS=Batch_Status
FIELD_BATCH_CENTER=Centres
FIELD_STUDENT_BATCH=Batch_ID

# ── User Management (feature-flag gate for widget access) ──────────────────────
# Report that controls which users can access the Face Attendance widget
ZOHO_USER_MGMT_REPORT=All_Users
FIELD_USER_MGMT_EMAIL=Zoho_ID
FIELD_USER_FACE_FEATURE=Face_Recognition_Feature

# ── Zoho Environment ───────────────────────────────────────────────────────────
# Leave blank for production. Set to "development" to target dev environment.
ZOHO_ENVIRONMENT=

# ── Face Recognition Settings ──────────────────────────────────────────────────
# Tolerance: how similar faces must be to count as a match.
# Must be between 0.20 and 0.80. Lower = stricter. Default = 0.40.
FACE_MATCH_TOLERANCE=0.40

# How long to cache student encodings (seconds). 86400 = 24 hours.
CACHE_TTL_SECONDS=86400

# ── Liveness / Anti-Spoofing ───────────────────────────────────────────────────
# Path to MiniFASNetV2.onnx model (baked in Docker image — no need to change)
LIVENESS_MODEL_PATH=/app/.anti_spoof/MiniFASNetV2.onnx
# Probability threshold: real face must score above this. Range [0,1]. Default 0.65.
LIVENESS_THRESHOLD=0.65

# ── App Settings ───────────────────────────────────────────────────────────────
# REQUIRED in production — must be a strong random string (e.g. openssl rand -hex 32)
SECRET_KEY=change_this_to_a_random_secure_string
# REQUIRED in production — protects all /admin/* endpoints
ADMIN_SECRET=change_this_to_a_random_secret
DEBUG=false
PORT=5000

# ── Keepalive (Render free tier) ───────────────────────────────────────────────
# Set to your Render service URL to prevent spin-down
SELF_URL=https://your-app.onrender.com

# ── Render API (for auto-refreshing Zoho token) ────────────────────────────────
# Get API key from: Render Dashboard → Account Settings → API Keys
RENDER_API_KEY=
# Get Service ID from: Render Dashboard → your service → Settings
RENDER_SERVICE_ID=
